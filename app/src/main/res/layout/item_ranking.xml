<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Miniatura planszy -->
        <GridLayout
            android:id="@+id/grid_mini_board"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:rowCount="4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Wynik -->
        <TextView
            android:id="@+id/tv_ranking_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="125 pkt"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/grid_mini_board"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Ilość słów -->
        <TextView
            android:id="@+id/tv_ranking_words"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="14 słów"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@id/grid_mini_board"
            app:layout_constraintTop_toBottomOf="@id/tv_ranking_score" />

        <!-- Czas gry -->
        <TextView
            android:id="@+id/tv_ranking_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Czas: 3:00"
            android:textSize="14sp"
            android:textStyle="italic"
            app:layout_constraintStart_toEndOf="@id/grid_mini_board"
            app:layout_constraintTop_toBottomOf="@id/tv_ranking_words" />

        <!-- Data gry -->
        <TextView
            android:id="@+id/tv_ranking_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12 Paź 2023, 15:30"
            android:textSize="12sp"
            android:textColor="#888888"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>